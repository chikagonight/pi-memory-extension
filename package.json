{
  "name": "pi-memory-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal hardened persistent memory extension for pi (facts/decisions between sessions).",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
